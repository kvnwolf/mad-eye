{
  "tracker": { "type": "github" },
  "release": {
    "type": "homebrew-cask",
    "tap": "kvnwolf/homebrew-tap",
    "cask": "mad-eye",
    "notaryProfile": "mad-eye-notary"
  },
  "files": [
    {
      "path": "CLAUDE.md",
      "update_when": ["When the stack, module map, or workflow changes"]
    },
    {
      "path": "CONTEXT.md",
      "update_when": [
        "When a domain term is added, renamed, or its meaning shifts"
      ]
    },
    {
      "path": "README.md",
      "update_when": ["When setup commands or usage change"]
    },
    {
      "path": "src-tauri/src/tray/CONTEXT.md",
      "update_when": [
        "When tray behavior, menu actions, Popover positioning, or invariants change"
      ]
    },
    {
      "path": "src-tauri/src/usage/CONTEXT.md",
      "update_when": [
        "When endpoint parsing, Gauge/Snapshot contracts, or driving policy change"
      ]
    }
  ],
  "checks": [
    {
      "name": "cargo test",
      "run": "cargo test --manifest-path src-tauri/Cargo.toml"
    }
  ]
}
